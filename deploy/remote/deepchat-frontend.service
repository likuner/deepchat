# DeepChat Next.js 前端服务 (next start :3000)
# 部署到 /etc/systemd/system/deepchat-frontend.service

[Unit]
Description=DeepChat Next.js Frontend (next start)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/deepchat/frontend
# setup.sh 将 Node 安装到 /opt/node20 并在此注入 PATH
Environment=PATH=/opt/node20/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/deepchat/frontend/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
